{
  "name": "velo-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server exposing velo.xyz's internal market-data API (price candles + aggregated derivatives indicators), reverse-engineered from the velo.xyz chart frontend.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "velo-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "dump": "tsc -p tsconfig.json && node dist/dump.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.5.1",
    "typescript": "^5.6.2"
  }
}
